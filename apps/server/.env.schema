# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# The web app's origin. Doubles as the base URL for links built into emails
# (invitation accept links, verification links) in the auth package's
# createAuth wiring, since it already is the app's public origin (also used
# for better-auth's trustedOrigins and CORS).
# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Resend API key. When set, the Resend email adapter is used instead of the
# console adapter (dev/test); requires EMAIL_FROM to also be set.
# @optional
# @type=string(startsWith=re_)
RESEND_API_KEY=

# Verified sender address for outgoing email (e.g. "App <no-reply(at)example.com>").
# Optional when RESEND_API_KEY is unset (the console adapter doesn't send real
# email); required in practice once RESEND_API_KEY is set, enforced by the
# auth package's createEmailSender factory, which throws at startup if
# RESEND_API_KEY is present without EMAIL_FROM.
# @optional
EMAIL_FROM=

# Default number of organizations a user may own before hitting the R1.1b
# limit. Overridable per-user via user.maxOrganizations (superadmin only).
# @type=number
DEFAULT_MAX_ORGS_PER_USER=3

# Retention window (in days) for audit_log entries (R7.6). Unset means "keep
# forever" — no retention job runs. When set, a scheduled job purges entries
# older than this many days.
# @optional
# @type=number
AUDIT_LOG_RETENTION_DAYS=

# Comma-separated emails to promote to the platform `superadmin` role (R6.1).
# Consumed only by the `pnpm db:seed:admins` command (apps/server/scripts/seed-admins.ts) —
# never read by the running server, and never exposed through any endpoint.
# Each email must already have an account (sign up first); the command is
# idempotent and only promotes, it never creates accounts.
# @optional
PLATFORM_ADMIN_EMAILS=

# Google OAuth client ID (server-only, never exposed to the web bundle).
# Set together with GOOGLE_CLIENT_SECRET to enable "Continue with Google";
# setting only one of the pair fails startup (auth package createAuth).
# Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/google
# @optional
GOOGLE_CLIENT_ID=

# Google OAuth client secret (server-only). See GOOGLE_CLIENT_ID.
# @optional
GOOGLE_CLIENT_SECRET=
